<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      M3 ShapeAppearance tokens. Parents are the official Material3 shapes;
      the aliases make call sites name the role, not the radius.
    -->
    <style name="ShapeAppearance.HyperFCMLive.ExtraSmall"
        parent="ShapeAppearance.Material3.Corner.ExtraSmall" />
    <style name="ShapeAppearance.HyperFCMLive.Small"
        parent="ShapeAppearance.Material3.Corner.Small" />
    <style name="ShapeAppearance.HyperFCMLive.Medium"
        parent="ShapeAppearance.Material3.Corner.Medium" />
    <style name="ShapeAppearance.HyperFCMLive.Large"
        parent="ShapeAppearance.Material3.Corner.Large" />
    <style name="ShapeAppearance.HyperFCMLive.ExtraLarge"
        parent="ShapeAppearance.Material3.Corner.ExtraLarge" />

    <!-- App roles mapped onto the scale above. -->
    <!-- Filled card (M3): no outline stroke; surface sits on page_bg. -->
    <style name="ShapeAppearance.HyperFCMLive.Card" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">@dimen/shape_corner_extra_large</item>
    </style>
    <style name="ShapeAppearance.HyperFCMLive.Menu" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">@dimen/shape_corner_large</item>
    </style>
    <style name="ShapeAppearance.HyperFCMLive.MenuItem" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">@dimen/shape_corner_medium</item>
    </style>
    <style name="ShapeAppearance.HyperFCMLive.Tooltip" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">@dimen/shape_corner_extra_small</item>
    </style>
    <style name="ShapeAppearance.HyperFCMLive.Fab" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">@dimen/shape_corner_large</item>
    </style>
</resources>
