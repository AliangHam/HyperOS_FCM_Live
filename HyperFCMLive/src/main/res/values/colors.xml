<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      Light fallback when Monet (API 31+) is unavailable.

      These are M3 color roles. Runtime values are painted from AppPalette /
      ThemeEngine (mcu Scheme). Aliases keep one source of truth with the
      older md_* names still referenced by layouts and drawables.
    -->
    <color name="md_primary">#8B4A5A</color>
    <color name="md_on_primary">#FFFFFF</color>
    <color name="md_primary_container">#F4D6DC</color>
    <color name="md_on_primary_container">#3B0A1A</color>
    <color name="md_secondary">#8B4A5A</color>
    <color name="md_on_secondary">#FFFFFF</color>
    <color name="md_secondary_container">#F4D6DC</color>
    <color name="md_on_secondary_container">#3B0A1A</color>
    <color name="md_tertiary">#8B4A5A</color>
    <color name="md_on_tertiary">#FFFFFF</color>
    <color name="md_tertiary_container">#F4D6DC</color>
    <color name="md_on_tertiary_container">#3B0A1A</color>
    <color name="md_error">#BA1A1A</color>
    <color name="md_on_error">#FFFFFF</color>
    <color name="md_error_container">#FFDAD6</color>
    <color name="md_on_error_container">#410002</color>

    <color name="md_surface">#F7EEF0</color>
    <color name="md_on_surface">#23191B</color>
    <color name="md_surface_variant">#F4D6DC</color>
    <color name="md_on_surface_variant">#534347</color>
    <!-- Container ramp used by cards / menus (matches AppPalette). -->
    <color name="md_surface_container_lowest">#FFFFFF</color>
    <color name="md_surface_container_low">#FFFFFF</color>
    <color name="md_surface_container">#F7EEF0</color>
    <color name="md_surface_container_high">#F0E0E3</color>
    <color name="md_surface_container_highest">#E9D9DD</color>
    <color name="md_surface_bright">#FFF8F8</color>
    <color name="md_surface_dim">#D8C5C9</color>
    <color name="md_surface_inverse">#382E30</color>
    <color name="md_on_surface_inverse">#FFEFF0</color>

    <color name="md_outline">#857377</color>
    <color name="md_outline_variant">#D8C0C5</color>

    <!-- Page background: one step deeper than the cards so they stand out. -->
    <color name="md_page_bg">#F2F2F3</color>
    <color name="md_card">#FFFFFF</color>
    <color name="md_icon_tint">#6B5158</color>
    <!-- Darkened for WCAG AA (>=4.5:1 on card/page). -->
    <color name="md_hint_light">#7A656A</color>

    <!-- Inverse surface tooltips (always contrast against the app surface). -->
    <color name="md_tooltip_bg">#E62D2D30</color>
    <color name="md_tooltip_text">#F4EFF4</color>

    <!-- Overflow menu: the page colour, so the menu and the page agree. -->
    <color name="md_popup_menu_bg">#F2F2F3</color>
    <color name="md_popup_item_ripple">#3D8B4A5A</color>

    <!-- Hover state layer: on-surface at 8%. -->
    <color name="md_state_hover">#1423191B</color>
</resources>
