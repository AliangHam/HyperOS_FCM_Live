<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      MaterialAlertDialog: official M3 extra-large corners and primary
      action colour. Parent supplies the dialog theme; we only pin shape
      and ensure buttons use the app primary role.
    -->
    <style name="ThemeOverlay.HyperFCMLive.Dialog" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="shapeAppearanceOverlay">@style/ShapeAppearance.HyperFCMLive.Dialog</item>
        <!-- Kill the title/message/button separator line. -->
        <item name="android:listDivider">@null</item>
        <!--
          MaterialAlertDialog draws 1dp scrollIndicatorUp/Down ImageViews with
          colorForeground tint — the lines under the title and above the button
          while the license text scrolls. Transparent foreground makes them
          invisible; showLicenseDialog also detaches the views after show().
        -->
        <item name="android:colorForeground">@android:color/transparent</item>
        <item name="android:colorForegroundInverse">@android:color/transparent</item>
        <item name="buttonBarPositiveButtonStyle">@style/Widget.HyperFCMLive.DialogButton</item>
        <item name="buttonBarNegativeButtonStyle">@style/Widget.HyperFCMLive.DialogButton</item>
        <item name="buttonBarNeutralButtonStyle">@style/Widget.HyperFCMLive.DialogButton</item>
    </style>

    <style name="ShapeAppearance.HyperFCMLive.Dialog" parent="ShapeAppearance.Material3.Corner.ExtraLarge" />

    <style name="Widget.HyperFCMLive.DialogButton" parent="Widget.Material3.Button.TextButton.Dialog">
        <item name="android:textColor">?attr/colorPrimary</item>
    </style>
</resources>
