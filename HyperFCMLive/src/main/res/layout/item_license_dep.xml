<?xml version="1.0" encoding="utf-8"?>
<!-- Dependency row: name + small version, license below.
     The card background (M3 connected-group ripple) is set in code by
     LicensesActivity, so its corner radii match the row's position. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:clickable="true"
    android:focusable="true"
    android:minHeight="72dp"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingTop="14dp"
    android:paddingEnd="16dp"
    android:paddingBottom="14dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:baselineAligned="true"
        android:gravity="bottom"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/dep_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/md_on_surface"
            style="@style/TextAppearance.HyperFCMLive.BodyLarge" />

        <TextView
            android:id="@+id/dep_version"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:textColor="@color/md_on_surface_variant"
            style="@style/TextAppearance.HyperFCMLive.BodySmall" />
    </LinearLayout>

    <TextView
        android:id="@+id/dep_license"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/md_on_surface_variant"
        style="@style/TextAppearance.HyperFCMLive.BodySmall" />
</LinearLayout>
