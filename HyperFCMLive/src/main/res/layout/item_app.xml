<?xml version="1.0" encoding="utf-8"?>
<!-- M3 filled card: no stroke; separation comes from surface vs page_bg. -->
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:clickable="true"
    android:focusable="true"
    android:minHeight="72dp"
    app:cardBackgroundColor="@color/md_card"
    app:cardElevation="0dp"
    app:strokeWidth="0dp"
    app:rippleColor="@color/md_popup_item_ripple"
    app:shapeAppearance="@style/ShapeAppearance.HyperFCMLive.Card">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingTop="12dp"
        android:paddingEnd="16dp"
        android:paddingBottom="12dp">

        <ImageView
            android:id="@+id/app_icon"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:contentDescription="@null"
            android:longClickable="false"
            android:tooltipText="@null" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <!-- Name and tag share one line: the name takes only the width it needs
                 so the tag sits right after it, and the cap that keeps a long name
                 from running over the tag is applied in AppListAdapter, where the
                 row's own width is known. -->
            <LinearLayout
                android:id="@+id/app_title_row"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/app_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="@color/md_on_surface"
                    style="@style/TextAppearance.HyperFCMLive.TitleMedium" />

                <TextView
                    android:id="@+id/app_mipush_badge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/bg_mipush_badge"
                    android:paddingStart="6dp"
                    android:paddingTop="2dp"
                    android:paddingEnd="6dp"
                    android:paddingBottom="2dp"
                    android:singleLine="true"
                    android:text="@string/mipush_badge"
                    android:textColor="@color/md_primary"
                    style="@style/TextAppearance.HyperFCMLive.LabelSmall"
                    android:visibility="gone" />
            </LinearLayout>

            <TextView
                android:id="@+id/app_pkg"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:breakStrategy="simple"
                android:hyphenationFrequency="none"
                android:textColor="@color/md_on_surface_variant"
                style="@style/TextAppearance.HyperFCMLive.BodySmall" />
        </LinearLayout>

        <ImageView
            android:id="@+id/app_status"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_marginStart="8dp"
            android:contentDescription="@null"
            android:longClickable="false"
            android:tooltipText="@null" />

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
