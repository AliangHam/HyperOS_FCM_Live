<?xml version="1.0" encoding="utf-8"?>
<!-- Press feedback only. Keep solid fill in bg_card / bg_card_selected so
     selection can swap background without sharing a RippleDrawable across rows. -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="@color/md_popup_item_ripple">
    <item android:id="@android:id/mask">
        <shape android:shape="rectangle">
            <solid android:color="@android:color/white" />
            <corners android:radius="@dimen/shape_corner_extra_large" />
        </shape>
    </item>
</ripple>
