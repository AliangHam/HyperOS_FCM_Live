<?xml version="1.0" encoding="utf-8"?>
<!-- MD3 FAB: 16dp corner radius (the FAB shape, not a pill). The explicit mask
     keeps the press ripple clipped to that same rounded rectangle. -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="#335A2A36">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/md_primary_container" />
            <corners android:radius="@dimen/shape_corner_large" />
        </shape>
    </item>
    <item android:id="@android:id/mask">
        <shape android:shape="rectangle">
            <solid android:color="@android:color/white" />
            <corners android:radius="@dimen/shape_corner_large" />
        </shape>
    </item>
</ripple>
